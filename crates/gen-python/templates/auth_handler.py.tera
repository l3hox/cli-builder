"""Authentication handler for {{ cli_name }}."""
import os
import sys

import click


def resolve_credential(ctx):
    """Resolve API credential from CLI flag or environment variable.

    Priority: --api-key flag > {{ auth.env_var }} environment variable.
    """
    api_key = ctx.obj.get("api_key")
    if api_key:
        return api_key
    api_key = os.environ.get("{{ auth.env_var }}")
    if api_key:
        return api_key
    click.echo(
        "Error: API key required. Use --api-key flag or set {{ auth.env_var }} environment variable.",
        err=True,
    )
    sys.exit(1)
